@{
    ViewData["Title"] = "Om oss";
}

<section class="hero-section text-center py-5">
    <div class="container">
        <h1 class="text-color-mint">Om Samåka Norr</h1>
        <p class="lead mt-3 text-muted">
            Vi på Samåka Norr vill göra resandet mer hållbart, socialt och prisvärt.
            Genom att koppla samman resenärer i norra Sverige vill vi minska klimatpåverkan
            och underlätta för människor att dela resor.
        </p>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <i class="fa fa-leaf fa-3x text-success mb-3"></i>
                <h4 class="fw-bold">Hållbart resande</h4>
                <p class="text-muted">Vi bidrar till minskade utsläpp genom samåkning.</p>
            </div>
            <div class="col-md-4 text-center">
                <i class="fa fa-users fa-3x text-accent-mustard mb-3"></i>
                <h4 class="fw-bold">Gemenskap</h4>
                <p class="text-muted">Samåkning skapar nya möten och sociala möjligheter.</p>
            </div>
            <div class="col-md-4 text-center">
                <i class="fa fa-wallet fa-3x text-dark mb-3"></i>
                <h4 class="fw-bold">Ekonomiskt</h4>
                <p class="text-muted">Genom att dela resor sparar vi pengar tillsammans.</p>
            </div>
        </div>
    </div>
</section>
