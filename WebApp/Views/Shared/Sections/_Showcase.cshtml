@model RidesViewModel

<div class="showcase">
    <div class="container">
        <img class="floating-image" src="~/images/showcase.png" alt="Showcase" />
        
        <div class="content">
            <div class="text-block">
                <h1>SAMÅKA <span>NORR</span></h1>
                <h2>Erbjud eller Efterfråga Resor</h2>
                <p>
                    Vår plattform kopplar samman resenärer för att göra resor mer hållbara,
                    prisvärda och sociala. Börja erbjuda eller boka din resa idag!
                </p>
            </div>
            <form method="post" asp-controller="Rides" asp-action="Index">
                <div class="input-group">
                    <label asp-for="SearchModel!.Origin"></label>
                    <input asp-for="SearchModel!.Origin" id="origin" />
                </div>
                <div class="input-group">
                    <label asp-for="SearchModel!.Destination"></label>
                    <input asp-for="SearchModel!.Destination" id="destination" />
                </div>
                <div class="input-group">
                    <label asp-for="SearchModel!.DepartureTime"></label>
                    <input asp-for="SearchModel!.DepartureTime" type="datetime-local" />
                </div>
                <button class="btn-gray" type="submit">Sök resan</button>
            </form>
        </div>
        
       
       
    </div>
</div>

