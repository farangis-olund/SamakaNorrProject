@model Infrastructure.Models.SearchViewModel
<section id="search">
    <input type="hidden" id="currentUsername" value="@User.Identity.Name" />
    <div class="container">
        @await Html.PartialAsync("~/Views/Shared/Sections/_StatusMessage.cshtml")
        <h1>Tillgängliga Förfrågningar</h1>
        
        <div class="heading">
            <form method="post" asp-controller="Search" asp-action="Search">
                <div class="content">

                    <div id="form-departure" class="input-group">
                        <input asp-for="SearchModel!.Origin" id="origin" />
                    </div>
                    <div id="form-destination" class="input-group">
                        <input asp-for="SearchModel!.Destination" id="destination" />
                    </div>
                   
                    <div id="form-date" class="input-group">
                        <input asp-for="SearchModel!.DepartureTime" />
                    </div>
                    <button id="form-button" class="btn-accent-mustard" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>

                    <!-- 📌 Toggle button for new request -->
                    <div class="input-group">
                        <button class="btn-accent-mustard" type="button" data-bs-toggle="collapse" data-bs-target="#postRequestForm">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>

                </div>
            </form>
            <div class="system-note">
                <strong>Observera!</strong> Alla förfrågningar som har passerat datumet kommer att tas bort automatiskt av systemet.
            </div>
            <!-- Collapsible new request form -->
            <div class="collapse" id="postRequestForm">
                <div class="card shadow-sm mb-4">
                    <div class="card-header">
                        <h4 class="mb-0">En ny förfrågan</h4>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Search" asp-action="Create" method="post" class="row g-3">
                            <!-- Origin -->
                            <div class="form-group">
                                <label for="origin">Origin:</label>
                                <div class="select-wrapper">
                                    @await Html.PartialAsync("~/Views/Shared/Sections/_VillageSelect.cshtml", "NewRequest.Origin")
                                </div>
                            </div>

                            <!-- Destination -->
                            <div class="form-group">
                                <label for="destination">Destination:</label>
                                <div class="select-wrapper">
                                    @await Html.PartialAsync("~/Views/Shared/Sections/_VillageSelect.cshtml", "NewRequest.Destination")
                                </div>
                            </div>
                            <div class="input-group">
                                <input asp-for="NewRequest.DepartureTime" type="datetime-local" class="input-group" />
                                <span class="text-danger" asp-validation-for="NewRequest.DepartureTime"></span>
                            </div>
                            <div class="input-group">
                                <input asp-for="NewRequest.SeatsRequired" type="number" placeholder="Antal platser" />
                                <span class="text-danger" asp-validation-for="NewRequest.SeatsRequired"></span>
                            </div>
                            <div class="input-group">
                                <textarea asp-for="NewRequest.Notes" placeholder="Extra information (valfritt)"></textarea>
                                <span class="text-danger" asp-validation-for="NewRequest.Notes"></span>
                            </div>
                            <div class="input-group">
                                <button type="submit" class="btn btn-accent-mustard">Posta</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>


            <!-- 📋 Requests List -->
            @if (Model.Requests.Any())
            {
                @foreach (var req in Model.Requests)
                {
                    <div class="request-card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-muted">
                                    @(req.DepartureTime?.ToString("dd.MM.yyyy") ?? "Ingen tid angiven")
                                </div>
                                <div class="fs-5">
                                    <span class="fw-bold">@req.Origin</span> →
                                    <span class="fw-bold">@req.Destination</span>
                                </div>
                                <div class="text-muted small">
                                    @(req.DepartureTime?.ToString("HH:mm") ?? "--:--")
                                </div>
                                <div>
                                    <span class="badge bg-info">
                                        @(req.SeatsRequired == 1 ? "1 plats" : $"{req.SeatsRequired} platser")
                                    </span>

                                </div>
                                @if (!string.IsNullOrWhiteSpace(req.Notes))
                                {
                                    <p class="fst-italic mt-2 mb-0">@req.Notes</p>
                                }
                            </div>

                            <div class="text-center">
                                 <a asp-controller="Account"
                                   asp-action="Profile"
                                   asp-route-id="@req.UserId"
                                   asp-route-returnUrl="@Url.Action("Index", "Search")">
                                @if (req.UserImgUrl != null)
                                {
                                    <img src="@req.UserImgUrl" class="rounded-circle mb-1" width="48" height="48" />
                                }
                                else
                                {
                                    <img src="~/images/uploads/profiles/avatar.svg" class="rounded-circle mb-1" width="48" height="48" />
                                }
                               
                                </a>



                                <div class="small">@req.UserName</div>

                                <button class="btn-chat" type="button"
                                        data-request-id="@req.Id"
                                        onclick="toggleSearchChat(this)">
                                    <i class="fa-regular fa-comment"></i> chatta
                                </button>

                                <!-- 📝 Only for owner -->
                                @if (req.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                {
                                    <div class="mt-2 d-flex gap-2 justify-content-center">
                                        <!-- Edit Icon -->
                                        <button type="button"
                                                class="btn-icon-warning"
                                                onclick="toggleEditForm(@req.Id)"
                                                title="Redigera">
                                            <i class="fa-solid fa-pencil"></i>
                                        </button>

                                        <!-- Delete -->
                                        <form asp-controller="Search"
                                              asp-action="Delete"
                                              asp-route-id="@req.Id"
                                              method="post"
                                              style="display:inline;">
                                            <button type="submit" class="btn-icon-danger" title="Ta bort">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 🔹 Inline hidden edit form -->
                        <div id="editForm-@req.Id" class="edit-form mt-3" style="display:none;">
                            <form asp-controller="Search" asp-action="Edit" method="post" class="row g-2">
                                <input type="hidden" name="Id" value="@req.Id" />

                                <!-- Origin -->
                                <div class="form-group">
                                    <label for="origin">Från:</label>

                                    <!-- Show current -->
                                    <input type="text" id="originText-@req.Id"
                                           name="Origin"
                                           class="form-control mb-2"
                                           value="@req.Origin" readonly />

                                    <!-- Dropdown (optional change) -->
                                    <div class="select-wrapper">
                                        @await Html.PartialAsync("~/Views/Shared/Sections/_VillageSelect.cshtml", "OriginSelect-" + req.Id)
                                        <script>
                                            document.addEventListener("DOMContentLoaded", function () {
                                                document.querySelectorAll("#OriginSelect-@req.Id, #DestinationSelect-@req.Id")
                                                    .forEach(el => el.removeAttribute("required"));
                                            });
                                        </script>
                                    </div>
                                </div>

                                <!-- Destination -->
                                <div class="form-group">
                                    <label for="destination">Till:</label>

                                    <!-- Show current -->
                                    <input type="text" id="destinationText-@req.Id"
                                           name="Destination"
                                           class="form-control mb-2"
                                           value="@req.Destination" readonly />

                                    <!-- Dropdown (optional change) -->
                                    <div class="select-wrapper">
                                        @await Html.PartialAsync("~/Views/Shared/Sections/_VillageSelect.cshtml", "DestinationSelect-" + req.Id)
                                        <script>
                                            document.addEventListener("DOMContentLoaded", function () {
                                                document.querySelectorAll("#OriginSelect-@req.Id, #DestinationSelect-@req.Id")
                                                    .forEach(el => el.removeAttribute("required"));
                                            });
                                        </script>
                                    </div>
                                </div>



                                <div class="col-md-6">
                                    <label>Avgångstid</label>
                                    <input type="datetime-local" name="DepartureTime"
                                           value="@(req.DepartureTime.HasValue ? req.DepartureTime.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
                                           class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label>Platser</label>
                                    <input type="number" name="SeatsRequired" value="@req.SeatsRequired"
                                           class="form-control" min="1" required />
                                </div>

                                <div class="col-12">
                                    <label>Noteringar</label>
                                    <textarea name="Notes" class="form-control">@req.Notes</textarea>
                                </div>

                                <div class="col-12 mt-2 d-flex gap-2">
                                    <button type="submit" class="btn-theme-mint"><i class="fa-solid fa-floppy-disk"></i> Spara</button>
                                    <button type="button" class="btn-beige"
                                            onclick="toggleEditForm(@req.Id)">
                                        <i class="fa-solid fa-xmark"></i> Avbryt
                                    </button>
                                </div>
                            </form>

                            <!-- ✅ Hook the script after this request’s edit form -->
                            <script>
                                hookVillageSelect(@req.Id);
                            </script>
                        </div>

                        <!-- 💬 Chat box -->
                        <div id="searchChat-@req.Id" class="search-messages" style="display:none;">
                            <div id="messagesBox-@req.Id" class="messages-box">
                                @if (req.Messages != null && req.Messages.Any())
                                {
                                    foreach (var msg in req.Messages)
                                    {
                                        var type = msg.Sender == Model.CurrentUser ? "sent" : "received";
                                        <div class="message-item @type">
                                            <div class="bubble">
                                                @if (type == "received")
                                                {
                                                    <div class="sender-name">@msg.Sender</div>
                                                }
                                                <div class="text">@msg.Text</div>
                                                <div class="timestamp">@msg.Timestamp.ToString("g")</div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted">Inga meddelanden ännu.</p>
                                }
                            </div>

                            <form onsubmit="sendSearchMessage(event, @req.Id)" class="chat-form">
                                <div class="chat-input-wrapper">
                                    <input type="text" id="messageText-@req.Id" placeholder="Skriv ett meddelande..." required />
                                    <button type="submit" class="send-btn">
                                        <i class="fa fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>

                        </div>

                    </div>
                }
            }
            else
            {
                <p class="text-muted">Inga förfrågningar hittades.</p>
            }


            

        </div>


    </div>
</section>

<script src="~/js/searchChatbox.js"></script>

<script>
    function toggleEditForm(id) {
        const form = document.getElementById("editForm-" + id);
        form.style.display = form.style.display === "none" ? "block" : "none";
    }
</script>

<script>
    function hookVillageSelect(reqId) {
        const originSelect = document.getElementById("OriginSelect-" + reqId);
        const originText = document.getElementById("originText-" + reqId);

        const destSelect = document.getElementById("DestinationSelect-" + reqId);
        const destText = document.getElementById("destinationText-" + reqId);

        if (originSelect) {
            originSelect.addEventListener("change", () => {
                if (originSelect.value && originSelect.value !== "") {
                    originText.value = originSelect.value;
                }
            });
        }

        if (destSelect) {
            destSelect.addEventListener("change", () => {
                if (destSelect.value && destSelect.value !== "") {
                    destText.value = destSelect.value;
                }
            });
        }
    }
</script>
